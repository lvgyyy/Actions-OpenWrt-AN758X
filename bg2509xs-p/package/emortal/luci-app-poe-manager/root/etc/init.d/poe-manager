#!/bin/sh /etc/rc.common

START=19
STOP=89
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/poe-manager run
	# Package upgrades call start: restart only when the executable changes.
	# Configuration changes are validated and applied by reload_service().
	procd_set_param file /usr/sbin/poe-manager
	procd_set_param term_timeout 8
	# Do not repeatedly reset PoE after a missing controller or failed init.
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger poe-manager
}

reload_service() {
	# The daemon validates the complete new policy before touching hardware.
	if procd_running poe-manager; then
		procd_send_signal poe-manager '*' HUP
	else
		start
	fi
}
